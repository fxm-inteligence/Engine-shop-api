datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Schema: AppDatabase

model Product {
  id String @id @default(uuid()) @db.Uuid
  name String
  price Float
  stock Int
  available Boolean?
  releasedAt DateTime?
  createdAt DateTime? @default(now())
}
